# Copy to .env and fill in. Everything is optional — the system degrades
# gracefully (no key = template narratives / no odds / no weather).

# Anthropic — Opus narratives + Sonnet Q&A
ANTHROPIC_API_KEY=

# The Odds API (https://the-odds-api.com) — K prop + HR prop lines
ODDS_API_KEY=

# WeatherAPI.com — game-time weather at outdoor parks
WEATHER_API_KEY=

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model routing (defaults shown; hybrid strategy for cost control)
# NARRATIVE_MODEL=claude-opus-4-7
# CHAT_MODEL=claude-sonnet-4-6
